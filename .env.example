# Copy to .env  --  cp .env.example .env
# .env is gitignored and IS loaded (config.py). Never commit a real key.

# ---- Stage 2 verifier ------------------------------------------------
# crossencoder = local, free, measured at 4% recovery on eval_heldout.py
# anthropic    = recommended; a model that reads instead of pattern-matching
VERIFY_BACKEND=crossencoder
# VERIFY_BACKEND=anthropic
VERIFY_LLM=claude-haiku-4-5
VERIFY_ACCEPT=0.97

# ---- The generator being cached --------------------------------------
# fake = sleeps 800ms, no key needed (all benchmark numbers use this)
LLM_BACKEND=fake
# LLM_BACKEND=anthropic
LLM_MODEL=claude-sonnet-5

# ---- Embeddings (stage 1 retrieval) ----------------------------------
EMBED_BACKEND=local
EMBED_MODEL=all-MiniLM-L6-v2

# ---- Keys ------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# Required only for identity-linked keys (Console > Settings >
# Workspaces; the id is in the URL, wrkspc_...). Harmless otherwise.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# OPENAI_API_KEY=sk-...

# ---- Cache tuning ----------------------------------------------------
CACHE_VERIFY=1
CACHE_TOP_K=5
CACHE_FLOOR=0.15
CACHE_TTL=3600
